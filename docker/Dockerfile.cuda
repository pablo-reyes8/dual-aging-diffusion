# CUDA training/inference image.
# Build from the repository root:
#   docker build -f docker/Dockerfile.cuda -t diffusion-aging:cuda .
# Run on an NVIDIA host with --gpus all.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/diffusion-aging \
    HF_HOME=/workspace/cache/huggingface \
    TRANSFORMERS_CACHE=/workspace/cache/huggingface/transformers \
    DIFFUSERS_CACHE=/workspace/cache/huggingface/diffusers

WORKDIR /workspace/diffusion-aging

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt requirements-training.txt pyproject.toml README.md ./

# The base image supplies the CUDA-enabled torch/torchvision pair. The project
# requirements accept those installed versions and add the diffusion, identity,
# test and notebook tooling without replacing the CUDA build.
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-training.txt \
    && python -m pip install --no-deps facenet-pytorch

COPY . .

# A safe default: validate the YAML and exit. Training is always explicit via
# `docker run ... python -m scripts.train_cli ...`.
CMD ["python", "-m", "scripts.train_cli", "--config", "configs/training/default_train.yaml", "--dry-run"]
