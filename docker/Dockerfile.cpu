# CPU verification/development image.
# Build from the repository root:
#   docker build -f docker/Dockerfile.cpu -t diffusion-aging:cpu .
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/diffusion-aging

WORKDIR /workspace/diffusion-aging

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt pyproject.toml README.md ./

# The verification image is intentionally CPU-only and is not a training image.
RUN python -m pip install --upgrade pip \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision \
    && python -m pip install -r requirements-dev.txt \
    && python -m pip install --no-deps facenet-pytorch

COPY . .

CMD ["pytest", "-q"]
